# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Public Supabase URL (used by client and edge functions)
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co

# Anonymous/Public Key (used by client, safe to expose)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (NEVER expose to client, used by edge functions only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Project ID (found in project URL)
SUPABASE_PROJECT_ID=your_project_id

# Personal Access Token for Supabase Management API
# Get from: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# =============================================================================
# Claude AI Configuration
# =============================================================================
# Get your API key from: https://console.anthropic.com/

# Claude API Key (used by multiple edge functions)
# IMPORTANT: This must be named CLAUDE_API_KEY (not ANTHROPIC_API_KEY)
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# =============================================================================
# Netlify Configuration (for web deployment)
# =============================================================================

# Netlify Authentication Token
NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# Netlify Site ID
NETLIFY_SITE_ID=your_netlify_site_id

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. Secrets Synchronization:
#    - Run 'npm run sync:secrets' after updating this file
#    - Secrets are automatically synced when deploying functions
#    - Git hooks will sync secrets when switching branches (after setup)
#
# 2. Edge Function Secrets:
#    - All CLAUDE_API_KEY, SUPABASE_URL, SUPABASE_ANON_KEY, and
#      SUPABASE_SERVICE_ROLE_KEY are automatically synced to Supabase
#    - These are accessible via Deno.env.get() in edge functions
#
# 3. Security:
#    - This file (.env) is in .gitignore and should NEVER be committed
#    - Use .env.example as a template for new developers
#    - Never expose SUPABASE_SERVICE_ROLE_KEY or CLAUDE_API_KEY publicly
#
# 4. Troubleshooting:
#    - Run 'npm run check:secrets' to verify all secrets are configured
#    - Check edge function logs if you see "not configured" errors
#    - Ensure secrets are synced after branch switches
#
# =============================================================================
