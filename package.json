{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "node ensure-watcher.mjs",
    "start": "expo start",
    "predev": "node ensure-watcher.mjs",
    "dev": "expo start --clear",
    "preandroid": "node ensure-watcher.mjs",
    "android": "expo start --android --clear",
    "preios": "node ensure-watcher.mjs",
    "ios": "expo start --ios --clear",
    "preweb": "node ensure-watcher.mjs",
    "web": "expo start --web --clear",
    "build": "expo export",
    "build:web": "expo export:web",
    "setup": "rm -rf node_modules package-lock.json && npm install && expo install --fix && npm install netlify-cli --save-dev",
    "clean": "rimraf node_modules package-lock.json && npm install",
    "doctor": "expo doctor",
    "type-check": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "netlify:link": "netlify link --id $NETLIFY_SITE_ID",
    "deploy": "netlify deploy --prod --dir=dist --auth $NETLIFY_AUTH_TOKEN --site $NETLIFY_SITE_ID --message \"bolt auto\"",
    "release": "npm run export:web && npm run deploy",
    "watcher:start": "node ensure-watcher.mjs",
    "watcher:stop": "node stop-watcher.mjs",
    "watcher:restart": "npm run watcher:stop && npm run watcher:start",
    "watcher:status": "node -e \"const fs = require('fs'); try { const pid = fs.readFileSync('watcher.pid', 'utf8'); process.kill(pid, 0); console.log('✅ Watcher is running (PID:', pid + ')'); } catch { console.log('❌ Watcher is not running'); }\"",
    "watcher:logs": "tail -f logs/watcher.log",
    "deploy:functions": "node deploy-functions.mjs",
    "sync:secrets": "node sync-secrets.mjs",
    "check:secrets": "node check-secrets.mjs",
    "verify:setup": "node verify-setup.mjs",
    "setup:hooks": "bash setup-git-hooks.sh",
    "postinstall": "bash setup-git-hooks.sh 2>/dev/null || true && node ensure-watcher.mjs 2>/dev/null || true",
    "init:watcher": "node init-watcher-system.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@supabase/supabase-js": "^2.80.0",
    "archiver": "^7.0.1",
    "ci-info": "^4.3.1",
    "expo": "54.0.23",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "17.0.9",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.12",
    "expo-router": "6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "6.0.8",
    "expo-web-browser": "15.0.9",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "^0.22.0",
    "@types/react": "~19.1.10",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.4",
    "napi-wasm": "^1.1.3",
    "netlify-cli": "^17.38.1",
    "node-fetch": "^3.3.2",
    "rimraf": "^5.0.10",
    "typescript": "~5.9.2",
    "update-notifier": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
